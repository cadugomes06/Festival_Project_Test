# Copie este arquivo para .env e ajuste os valores conforme seu ambiente.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/festival_pedidos?schema=public"

PORT=3000

# Autenticação: credencial única fixa (sem tabela de usuários — ver README).
# ADMIN_PASSWORD_HASH é o hash bcrypt da senha, nunca a senha em texto puro.
# Gerar um novo hash: node -e "console.log(require('bcryptjs').hashSync('SUA_SENHA', 10))"
JWT_SECRET="troque-por-um-segredo-forte-em-producao"
JWT_EXPIRES_IN="1h"
ADMIN_EMAIL="admin@festival.com"
ADMIN_PASSWORD_HASH="$2b$10$d/BKfF.we1evIdYflu0a9uI1SBw9KrGdObORNi9tywEaK6Tnae2cm"
